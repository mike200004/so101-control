<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Joint limits, kept identical to the <limit> tags in so101_body.xacro. -->
  <xacro:property name="limits" value="${dict(
      shoulder_pan=(-1.91986, 1.91986),
      shoulder_lift=(-1.74533, 1.74533),
      elbow_flex=(-1.69, 1.69),
      wrist_flex=(-1.65806, 1.65806),
      wrist_roll=(-2.74385, 2.84121),
      gripper=(-0.174533, 1.74533))}"/>

  <xacro:macro name="so101_joint" params="name mapping:=revolute">
    <joint name="${name}">
      <param name="mapping">${mapping}</param>
      <command_interface name="position">
        <param name="min">${limits[name][0]}</param>
        <param name="max">${limits[name][1]}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="so101_ros2_control"
               params="name use_mock_hardware port calibration_file">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>so101_hardware/SO101SystemHardware</plugin>
          <param name="port">${port}</param>
          <param name="baudrate">1000000</param>
          <param name="calibration_file">${calibration_file}</param>
          <param name="verify_homing_offset">true</param>
          <param name="torque_off_on_deactivate">true</param>
          <param name="max_consecutive_read_failures">5</param>
          <!-- Same position-loop gains LeRobot's SO follower uses. -->
          <param name="p_coefficient">16</param>
          <param name="i_coefficient">0</param>
          <param name="d_coefficient">32</param>
        </xacro:unless>
      </hardware>
      <xacro:so101_joint name="shoulder_pan"/>
      <xacro:so101_joint name="shoulder_lift"/>
      <xacro:so101_joint name="elbow_flex"/>
      <xacro:so101_joint name="wrist_flex"/>
      <xacro:so101_joint name="wrist_roll"/>
      <!-- LeRobot treats the gripper as 0-100 % of its calibrated range; map
           that range linearly onto the URDF jaw limits. -->
      <xacro:so101_joint name="gripper" mapping="linear"/>
    </ros2_control>
  </xacro:macro>

</robot>
