<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101">

  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="port" default="/dev/ttyACM0"/>
  <xacro:arg name="calibration_file" default=""/>

  <xacro:include filename="$(find so101_description)/urdf/so101_body.xacro"/>
  <xacro:include filename="$(find so101_description)/urdf/so101.ros2_control.xacro"/>

  <xacro:so101_body/>

  <xacro:so101_ros2_control
    name="so101"
    use_mock_hardware="$(arg use_mock_hardware)"
    port="$(arg port)"
    calibration_file="$(arg calibration_file)"/>

</robot>
